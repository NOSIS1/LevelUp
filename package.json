{
  "name": "levelup",
  "version": "1.1.0",
  "description": "Local-first learning progression tracker for English and programming",
  "repository": {
    "type": "git",
    "url": "https://github.com/NOSIS1/LevelUp.git"
  },
  "homepage": "https://github.com/NOSIS1/LevelUp#readme",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "next lint",
    "check": "npm run type-check && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node scripts/setup.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.469.0",
    "next": "15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "5.4.5",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
